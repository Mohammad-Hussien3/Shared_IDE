# Compose interpolation only. Backend secrets belong in backend/.env.
# Copy the CURRENT values from backend/.env; changing these does not update
# credentials in an existing PostgreSQL volume.
POSTGRES_DB=shared_ide
POSTGRES_USER=shared_ide_user
POSTGRES_PASSWORD=replace-with-your-existing-database-password
POSTGRES_PORT=55432

# Single browser-facing origin. Compose derives the Google callback from this.
# Register http://localhost:8080/api/auth/google/callback/ (trailing slash included)
# under Authorized redirect URIs for the Web client matching backend GOOGLE_CLIENT_ID.
APP_ORIGIN=http://localhost:8080
APP_HOSTS=localhost,127.0.0.1
APP_BIND=127.0.0.1
APP_PORT=8080
# Local HTTP only. Production requires HTTPS, false DEBUG, secure cookies.
DJANGO_DEBUG=true
AUTH_COOKIE_SECURE=false

# Public frontend build configuration; rebuild frontend after changing it.
VITE_SENTRY_DSN=
VITE_SENTRY_DISABLED=false
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Optional restricted HOST worker (Linux rootless Podman); see EXECUTION.md.
# Run make runner-setup, runner-images and runner-check before enabling.
CODE_EXECUTION_ENABLED=false
# Numeric primary group of the user running make runner-setup: id -g
RUNNER_GID=1000
