# Copy to .env and replace the secret key with a unique random value.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_NAME=db.sqlite3

# Optional Sentry backend project. Empty DSN disables monitoring.
SENTRY_DSN=
SENTRY_DISABLED=false
SENTRY_ENVIRONMENT=development
# Opt-in performance sampling, capped at 0.05 (5%); 0 disables tracing.
SENTRY_TRACES_SAMPLE_RATE=0

# SMTP delivery. For console-only development, explicitly choose console.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=YourEmail
EMAIL_HOST_PASSWORD=YourAppPassword
DEFAULT_FROM_EMAIL=Shared IDE <noreply@example.com>
FRONTEND_URL=http://localhost:5173

# Vite uses /api to proxy Django while keeping browser cookies same-origin.
# For direct API URLs, use the same hostname for frontend and backend.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Defaults to true when DJANGO_DEBUG=false. Use false only for local HTTP.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
# Optional separate strong JWT key; otherwise DJANGO_SECRET_KEY is used.
# JWT_SIGNING_KEY=replace-with-another-long-random-secret

# Google OAuth Web application credentials (backend only; optional).
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback/
# Register this exact URI with Google. Vite proxies it to the Django callback.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback/
GOOGLE_FRONTEND_ORIGIN=http://localhost:5173
