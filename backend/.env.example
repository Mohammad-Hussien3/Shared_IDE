# Copy to .env and replace the secret key with a unique random value.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_NAME=db.sqlite3

# Vite uses /api to proxy Django while keeping browser cookies same-origin.
# For direct API URLs, use the same hostname for frontend and backend.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Defaults to true when DJANGO_DEBUG=false. Use false only for local HTTP.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
# Optional separate strong JWT key; otherwise DJANGO_SECRET_KEY is used.
# JWT_SIGNING_KEY=replace-with-another-long-random-secret
