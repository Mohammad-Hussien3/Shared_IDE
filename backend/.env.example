# Copy to .env and replace the secret key with a unique random value.
# Single-quote values containing $ so Compose keeps them literal.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=shared_ide
POSTGRES_USER=shared_ide_user
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
# Use require (or verify-full with a trusted CA) for a remote database.
POSTGRES_SSLMODE=prefer

# Optional Sentry backend project. Empty DSN disables monitoring.
SENTRY_DSN=
SENTRY_DISABLED=false
SENTRY_ENVIRONMENT=development
# Opt-in performance sampling, capped at 0.05 (5%); 0 disables tracing.
SENTRY_TRACES_SAMPLE_RATE=0

# SMTP delivery. For console-only development, explicitly choose console.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=YourEmail
EMAIL_HOST_PASSWORD=YourAppPassword
DEFAULT_FROM_EMAIL=Shared IDE <noreply@example.com>
FRONTEND_URL=http://localhost:8080

# Vite uses /api to proxy Django while keeping browser cookies same-origin.
# For direct API URLs, use the same hostname for frontend and backend.
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Defaults to true when DJANGO_DEBUG=false. Use false only for local HTTP.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
# Optional separate strong JWT key; otherwise DJANGO_SECRET_KEY is used.
# JWT_SIGNING_KEY=replace-with-another-long-random-secret

# Google OAuth Web application credentials (backend only; optional).
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_FRONTEND_ORIGIN=http://localhost:8080
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback/
# Register this exact URI with Google. Vite proxies it to the Django callback.

# Compose overrides browser origins using APP_ORIGIN from the root .env.
# Google callback in Compose: http://localhost:8080/api/auth/google/callback/
# Add that exact URL to the same Google Web client's Authorized redirect URIs.
# Changing this file alone cannot override Compose's APP_ORIGIN-derived callback.
# Keep Google client secrets, SMTP credentials, and backend Sentry DSN here.
# Enable only after TLS terminates at the trusted, header-overwriting proxy.
DJANGO_TRUST_PROXY_HTTPS=false
# Off until a prepared rootless Podman environment is available.
# Compose uses root .env's flag and forces transport=unix (restricted host worker).
CODE_EXECUTION_ENABLED=false
# Native Django only: local uses this user's rootless Podman; unix uses the worker.
CODE_RUNNER_TRANSPORT=local
# Required for native Django using unix; Compose sets /run/shared-ide-worker.
# CODE_WORKER_DIRECTORY=/absolute/path/to/Shared_IDE/.runtime/runner

# Collaboration: Compose overrides this with its internal Redis service.
# Leave empty only for single-process host development or isolated unit tests.
# Multiple backend processes MUST use the same private Redis instance.
REDIS_URL=
