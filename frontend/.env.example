# Vite proxies HTTP and WebSocket requests to Django on 127.0.0.1:8000.
# Relative URLs keep cookies on localhost OR 127.0.0.1, whichever you open.
VITE_API_URL=/api

# Optional, separate Sentry React project. VITE values are public build settings.
VITE_SENTRY_DSN=
VITE_SENTRY_DISABLED=false
VITE_SENTRY_ENVIRONMENT=development
# Opt-in navigation timing, capped at 0.05 (5%); no Replay or source-code capture.
VITE_SENTRY_TRACES_SAMPLE_RATE=0
